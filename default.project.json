{
  "name": "roblox-cnr",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$path": { "optional": "Packages" }
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "MaskUp": { "$className": "RemoteEvent" },
        "TakeItem": { "$className": "RemoteEvent" },
        "PutItem": { "$className": "RemoteEvent" },
        "GiveItem": { "$className": "RemoteEvent" },
        "Shoot": { "$className": "RemoteEvent" },
        "ShotFired": { "$className": "RemoteEvent" },
        "OpenStash": { "$className": "RemoteEvent" },
        "InventoryChanged": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}